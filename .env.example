# ===================================================================
# CONFIGURATION TEMPLATE - DO NOT USE REAL API KEYS HERE
# Copy this file to .env and fill in your actual API keys
# ===================================================================

# DeepSeek API (cheap) - Get your key at https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API (paid) - Get your key at https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Anthropic API (paid) - Get your key at https://console.anthropic.com
# The Claude models are called through the claude command-line client; set its
# path here if it is not on PATH.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_CMD=claude

# Elasticsearch Configuration
ELASTICSEARCH_HOST=http://localhost:9200
