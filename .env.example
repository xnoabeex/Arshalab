# ===================================================================
# CONFIGURATION TEMPLATE - DO NOT USE REAL API KEYS HERE
# Copy this file to .env and fill in your actual API keys
# ===================================================================

# DeepSeek API (cheap) - Get your key at https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq API (FREE) - Get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Anthropic API (paid) - Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Elasticsearch Configuration
ELASTICSEARCH_HOST=http://localhost:9200
